# keystore.properties — EXAMPLE FILE
#
# Copy this file to keystore.properties (in the project root) and fill in
# the real values BEFORE running a release build.
#
# IMPORTANT: keystore.properties MUST NEVER be committed to version control.
#            It is already listed in .gitignore.
#
# How to generate a keystore:
#   keytool -genkeypair -v \
#     -keystore release-keystore.jks \
#     -alias your-key-alias \
#     -keyalg RSA \
#     -keysize 2048 \
#     -validity 10000
#
# Store the resulting .jks file somewhere SAFE (e.g. a password manager or
# a secure CI secret). If you lose it you cannot update your Play Store app.

# Absolute or project-relative path to the keystore file
storeFile=release-keystore.jks

# Password you set when you created the keystore
storePassword=your_store_password_here

# Alias you chose when you created the keystore
keyAlias=your_key_alias_here

# Password for the key entry (can be the same as storePassword)
keyPassword=your_key_password_here
