<?xml version="1.0" encoding="utf-8"?>
<!--
   Backup rules — Buyer App
   Excludes authentication tokens and sensitive preferences from cloud backup.
   Used by android:fullBackupContent="@xml/backup_rules"
-->
<full-backup-content>
    <!-- Exclude DataStore prefs that contain auth tokens -->
    <exclude domain="file" path="datastore/khabar_lagbe_prefs.preferences_pb" />
</full-backup-content>
