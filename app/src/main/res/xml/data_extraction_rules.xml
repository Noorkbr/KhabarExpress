<?xml version="1.0" encoding="utf-8"?>
<!--
   Data extraction rules — Buyer App
   Excludes authentication tokens and sensitive preferences from cloud backup
   and device-to-device transfers.
   Used by android:dataExtractionRules="@xml/data_extraction_rules"
-->
<data-extraction-rules>
    <cloud-backup>
        <!-- Exclude DataStore prefs that contain auth tokens -->
        <exclude
            domain="file"
            path="datastore/khabar_lagbe_prefs.preferences_pb" />
    </cloud-backup>
    <device-transfer>
        <!-- Exclude DataStore prefs that contain auth tokens -->
        <exclude
            domain="file"
            path="datastore/khabar_lagbe_prefs.preferences_pb" />
    </device-transfer>
</data-extraction-rules>
